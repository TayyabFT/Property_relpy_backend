{
  "version": 2,
  "buildCommand": "npm run vercel-build",
  "rewrites": [
    { "source": "/(.*)", "destination": "/api" }
  ],
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 60,
      "includeFiles": "{emails/**,src/**}"
    }
  },
  "crons": [
    {
      "path": "/api/cron/membership-renewal",
      "schedule": "0 8 * * *"
    }
  ]
}
