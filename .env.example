PORT=5000

# =============================================================================
# DATABASE (required on Vercel — Atlas)
# =============================================================================
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/propertyreply?retryWrites=true&w=majority
# Must be false on Vercel
USE_MEMORY_DB=false

# =============================================================================
# AUTH
# =============================================================================
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Frontend URL (Vercel frontend in production, e.g. https://propertyreply.vercel.app)
CLIENT_URL=http://localhost:3000

# Public API URL (this backend’s public URL, e.g. https://propertyreply-api.vercel.app)
PUBLIC_API_URL=

# Default admin (seeded on boot)
ADMIN_EMAIL=admin@propertyreply.co.uk
ADMIN_PASSWORD=admin12345
ADMIN_FIRST_NAME=Site
ADMIN_LAST_NAME=Admin

# =============================================================================
# EMAIL (SMTP)
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-16-char-app-password
EMAIL_FROM=your-gmail-address@gmail.com

# =============================================================================
# STRIPE — Billing + Identity
# Local: use test keys (sk_test_ / pk_test_)
# Production: use live keys (sk_live_ / pk_live_)
# =============================================================================
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Billing webhook signing secret (Dashboard → Developers → Webhooks)
# Local: stripe listen --forward-to http://localhost:5001/api/billing/webhook
# Prod:  create endpoint https://YOUR_API/api/billing/webhook
STRIPE_WEBHOOK_SECRET=

# Identity (KYC)
STRIPE_IDENTITY_STATIC_MODE=false
# Local: stripe listen --forward-to http://localhost:5001/api/kyc/webhook
# Prod:  create endpoint https://YOUR_API/api/kyc/webhook
STRIPE_IDENTITY_WEBHOOK_SECRET=

# =============================================================================
# VERCEL CRON (protects /api/cron/*)
# =============================================================================
# Generate any long random string. Vercel Cron should send:
#   Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
