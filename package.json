{
  "name": "propertyreply-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "PropertyReply API — Node.js + Express + MongoDB",
  "main": "index.js",
  "scripts": {
    "dev": "node scripts/build-email.mjs && node --import tsx --watch src/local-server.js",
    "start": "node scripts/build-email.mjs && node --import tsx src/local-server.js",
    "build": "node scripts/build-email.mjs && node --check src/local-server.js && node --check src/vercel-handler.js",
    "typecheck": "tsc --noEmit",
    "vercel-build": "node scripts/build-vercel.mjs"
  },
  "engines": {
    "node": "20.x"
  },
  "dependencies": {
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.9",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "esbuild": "^0.28.1",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1",
    "nodemailer": "^9.0.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "stripe": "^22.3.2",
    "tsx": "^4.22.4"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "mongodb-memory-server": "^10.1.4",
    "typescript": "^6.0.3"
  }
}
